async function signIn(){if(demo){notice('Microsoft sign-in is disabled in sample mode.');return;}if(pending){notice('A sign-in is already in progress.');return;}const tenant=$('tenant').value.trim(),client=$('client').value.trim();const guid=/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i;if(!guid.test(tenant)||!guid.test(client)){notice('Enter your tenant ID and app registration client ID as GUIDs.');return;}if(location.protocol!=='https:'){notice('Tenant sign-in needs an HTTPS address registered as an Entra SPA redirect URI.');return;}

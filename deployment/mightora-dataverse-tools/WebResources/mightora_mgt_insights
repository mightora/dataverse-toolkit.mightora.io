 else if(scope==='Environment'){if(!clientUrl)throw Error('No authenticated Dataverse environment. Install this HTML web resource first.');for(const [source,path] of sources){notice('Reading '+source+'…');try{const data=await collectPages(getDataverse,path);result.resources.push(...data.rows.map(r=>cleanResource(r,source)));result.coverage.push({source,status:data.partial?'Partial':'Loaded',detail:`${data.rows.length} visible records. Row security may restrict results.`});}catch(e){result.coverage.push({source,status:'Unavailable',detail:e.message});}}}

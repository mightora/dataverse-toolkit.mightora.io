 if(r.type==='solutions'&&r.managed===false&&!['Default Solution','Active Solution','Common Data Services Default Solution'].includes(r.name))out.push({severity:'Review',title:'Unmanaged solution',detail:'Review against your environment ALM policy. Unmanaged solutions can be appropriate in development.',evidence});
 if(r.quarantined===true)out.push({severity:'Attention',title:'Quarantined resource',detail:'Check the reason in the admin centre before taking action.',evidence});

async function getDataverse(path){if(!clientUrl)throw Error('Open the installed web resource in a signed-in Dataverse app.');const root=new URL(clientUrl+'/api/data/v9.2/');const url=new URL(path,root);if(url.origin!==root.origin||!url.pathname.startsWith(root.pathname))throw Error('Blocked API URL');const response=await fetch(url,{credentials:'same-origin',headers:{Accept:'application/json',Prefer:'odata.maxpagesize=1000'},signal:AbortSignal.timeout(60000)});if(!response.ok)throw Error('Dataverse HTTP '+response.status+(response.status===403?' — insufficient privileges':''));return response.json();}

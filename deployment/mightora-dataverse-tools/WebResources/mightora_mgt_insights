async function scan(){ const generation=++scanGeneration; $('scan').disabled=true;snapshot=null;renderEmpty();const scope=$('scope').value;const result={format:'mightora-platform-insights',version:1,demo,scope,context:scope==='Tenant'?$('tenant').value.trim():clientUrl||'sample-environment',capturedAt:new Date().toISOString(),coverage:[],resources:[]};notice('Reading data…');try{
